{
    "name": "portfolio/spa-booking-system",
    "description": "A fictional framework-free PHP and MySQL spa appointment booking portfolio project.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SpaBooking\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpaBooking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "phpcs --standard=PSR12 app config public routes tests",
        "analyse": "phpstan analyse app config public routes --level=8",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
