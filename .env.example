APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Chicago

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spa_booking
DB_USERNAME=spa_app
DB_PASSWORD=replace-with-local-password
DB_CHARSET=utf8mb4

# Integration tests run only when both values below are explicitly configured.
DB_TEST_DATABASE=spa_booking_test
RUN_DATABASE_TESTS=false
